{
    "name": "craigiswayne/wp-azure-application-insights",
    "description": "Azure Application Insights in WordPress",
    "type": "wordpress-plugin",
    "keywords": [
        "wordpress",
        "plugin",
        "azure",
        "application insights"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Craig Wayne",
            "email": "craigiswayne@gmail.com",
            "role": "Developer"
        }
    ],
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "craigiswayne/application-insights-sdk",
                "version": "dev-feature/cve-shit",
                "type": "library",
                "source": {
                    "url": "https://github.com/craigiswayne/application-insights-sdk-php",
                    "type": "git",
                    "reference": "origin/feature/cve-shit"
                }
            }
        }
    ],
    "require": {
        "craigiswayne/application-insights-sdk": "dev-feature/cve-shit"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.0"
    },
    "config": {
        "platform": {
            "php": "8.2"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": "./vendor/bin/phpcs -psl . --standard=WordPress --ignore=vendor/",
        "lint:fix": "./vendor/bin/phpcbf . --standard=WordPress --ignore=vendor/"
    }
}
